\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cvstyle}[2026/09/02 v1.0 Layout, colours, and content macros over AltaCV]

\RequirePackage[british]{babel}
\RequirePackage[default]{sourcesanspro}
\RequirePackage[tracking=true]{microtype}
\RequirePackage{needspace}
\SetTracking{encoding=*, shape=n}{40}

\geometry{a4paper, left=2.2cm, right=2.2cm, top=1.6cm, bottom=1.6cm}
% Boxes overfull by a tenth of a point are invisible in print but would fail the log check.
\setlength{\hfuzz}{1pt}
% pdftocairo copies only the ink, so without this the SVG preview is transparent.
\pagecolor{white}

% The class already applies \RaggedRight, but 2em of slack is too little to set this measure without
% hyphens, so Terraform was splitting across lines. Banning them needs the wider slack, or short
% lines become underfull boxes and fail the build.
\setlength{\RaggedRightRightskip}{0pt plus 5em}
\linespread{1.05}
\hyphenpenalty=10000
\exhyphenpenalty=10000
\widowpenalty=10000
\clubpenalty=10000

\definecolor{SlateGrey}{HTML}{2E2E2E}
\definecolor{LightGrey}{HTML}{666666}
\colorlet{name}{black}
\colorlet{tagline}{SlateGrey}
\colorlet{heading}{black}
\colorlet{headingrule}{LightGrey}
\colorlet{divider}{LightGrey!25}
\colorlet{accent}{SlateGrey}
\colorlet{emphasis}{black}
\colorlet{body}{SlateGrey}

% Only \cvmetric is bold, so a skim lands on the figures.
\renewcommand{\namefont}{\Huge\lsstyle}
\renewcommand{\taglinefont}{\normalsize}
% Wrapping here rather than in \taglinefont, which is a font switch and cannot take the text.
\renewcommand{\tagline}[1]{\def\@tagline{\textls[120]{\MakeUppercase{#1}}}}
\renewcommand{\personalinfofont}{\footnotesize}
\renewcommand{\cvsectionfont}{\Large}
\renewcommand{\cvItemMarker}{{\small\color{headingrule}\textbullet}}
\renewcommand{\cvLocationMarker}{\faMapMarker*}

% Set once by \cvsection and cleared by the first \cvrole under it, so a role opening a section is
% not pushed away from its own heading by the gap that separates one role from the next.
\newif\if@cvfirstinsection

% Set from \cvsection's optional argument, so a section of two-line entries can opt out of rules
% that would weigh more than the entries they separate.
\newif\if@cvdividers

\newcounter{cvsection}

% The class hardcodes a 2pt rule and a margin-note hook for its sidebar layout.
\RenewDocumentCommand{\cvsection}{O{} m}{%
  \par\addvspace{1.1\baselineskip}%
  \needspace{5\baselineskip}%
  \stepcounter{cvsection}%
  \pdfbookmark[1]{#2}{cvsection.\thecvsection}%
  {\color{heading}\cvsectionfont\textls[80]{\MakeUppercase{#2}}}\par\nobreak
  \vspace{-0.6ex}%
  {\color{headingrule}\rule{\linewidth}{0.4pt}}\par\nobreak
  \vspace{0.4\baselineskip}%
  \@cvfirstinsectiontrue
  \ifstrequal{#1}{nodivider}{\@cvdividersfalse}{\@cvdividerstrue}%
}

\NewInfoField{source}{\faCodeBranch}[https://github.com/]

% The class forces \pagestyle{empty} from a begindocument/before hook, so a sheet parted from the
% others carries nothing identifying. \AtEndDocument runs before the final \clearpage, which puts
% this label on the last page and saves loading lastpage for one reference.
\AtEndDocument{\label{cv@lastpage}}
\newcommand{\ps@cvfooter}{%
  \renewcommand{\@oddhead}{}%
  \renewcommand{\@evenhead}{}%
  \renewcommand{\@oddfoot}{%
    \footnotesize\color{headingrule}\@name\hfill\thepage\ of \pageref{cv@lastpage}%
  }%
  \let\@evenfoot\@oddfoot
}
% Page one names him in the header already, and the class's hook has to have run before this.
\AtBeginDocument{\pagestyle{cvfooter}\thispagestyle{empty}}

\NewDocumentCommand{\cvmetric}{m}{{\color{emphasis}\textbf{#1}}}

% A macro rather than a length, so it tracks the \baselineskip in force where the rule is drawn.
\newcommand{\cvdividersep}{0.8\baselineskip}
% Drawn only between roles, never above the first in a section or below the last, which the
% \if@cvfirstinsection branch in \cvrole gets for free. \nointerlineskip drops the baselineskip glue
% the rule would otherwise sit on, so \cvdividersep alone sets the gap and centres it.
\newcommand{\cvdivider}{%
  \addvspace{\cvdividersep}%
  \nointerlineskip
  \noindent{\color{divider}\rule{\linewidth}{0.4pt}}\par
  \vspace{\cvdividersep}%
}

% #1 title, #2 employer, #3 dates
\NewDocumentCommand{\cvrole}{m m m}{%
  \par
  \if@cvfirstinsection
    \@cvfirstinsectionfalse
  \else
    \if@cvdividers
      \cvdivider
    \else
      \addvspace{1.1\baselineskip}%
    \fi
  \fi
  \needspace{5\baselineskip}%
  {\large\color{emphasis}#1}\hfill{\small\color{headingrule}#3}\par\nobreak
  {\color{accent}#2}\par\nobreak
  \vspace{0.35\baselineskip}%
}

\newlength{\cvskilllabelwidth}
\setlength{\cvskilllabelwidth}{8em}
% #1 label, #2 comma-separated items
\NewDocumentCommand{\cvskillline}{m m}{%
  \noindent
  \makebox[\cvskilllabelwidth][l]{\color{emphasis}#1}%
  \parbox[t]{\dimexpr\linewidth-\cvskilllabelwidth\relax}{\raggedright #2}%
  \par\smallskip
}

\endinput
